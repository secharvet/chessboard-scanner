# API Node (coach/server.mjs) : dépôt entier monté en volume, AUCUN build. `node --watch` relance le process
# automatiquement à chaque modification de fichier source — éditer, sauvegarder, c'est tout.
[Unit]
Description=API plateforme échecs (Node, source en volume, --watch)
After=chess-db.service
Requires=chess-db.service

[Container]
Image=docker.io/library/node:22-bookworm-slim
ContainerName=chess-api
Network=chess.network
Volume=/home/ubuntu/chessboard-scanner:/app:Z
# Stockfish de l'hôte (binaire glibc, d'où l'image Debian et non Alpine) : le coach et la vérification des fautes en ont besoin
Volume=/usr/local/bin/stockfish:/usr/local/bin/stockfish:ro
# Maia-1500 (lc0 + poids) de l'hôte : la page « Faire jouer le coach » lance des parties contre Maia depuis l'API
Volume=/home/ubuntu/bin/maia:/home/ubuntu/bin/maia:ro
WorkingDir=/app
Exec=node --watch coach/server.mjs
EnvironmentFile=/home/ubuntu/chessboard-scanner/db/.env.db
PublishPort=8000:8000
# Santé : si /health ne répond plus (par exemple node --watch arrêté sur une erreur), Podman redémarre le conteneur
HealthCmd=node /app/scripts/sante-api.mjs
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=20s
HealthOnFailure=restart

[Service]
Restart=always

[Install]
WantedBy=default.target
